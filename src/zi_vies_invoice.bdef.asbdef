managed implementation in class zbp_i_vies_invoice unique;
strict ( 2 );
with draft;

define behavior for Zi_vies_invoice alias Invoice
persistent table zvies_invoice
draft table zvies_invoice_d
lock master
total etag ModifiedAt
authorization master ( global )
etag master ModifiedAt
{
  create;
  update;
  delete;

  field ( numbering: managed, readonly ) InvoiceId;

  field ( readonly ) AmountEur, CurrencyEur, Status, CreatedBy, CreatedAt, ModifiedBy, ModifiedAt;

  field ( mandatory ) InvoiceNo, VendorId, AmountLC, CurrencyLC, InvoiceDate;

  validation checkViesStatus on save { field VendorId; create; update; }

  determination convertToEur on modify { field AmountLC, CurrencyLC, InvoiceDate; }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;


  draft determine action Prepare {
    validation checkViesStatus;
  }

  mapping for zvies_invoice {
    InvoiceId   = invoice_id;
    InvoiceNo   = invoice_number;
    VendorId    = vendor_id;
    AmountLC    = amount_lc;
    CurrencyLC  = currency_lc;
    AmountEur   = amount_eur;
    CurrencyEur = currency_eur;
    InvoiceDate = invoice_date;
    DcIndicator = dc_indicator;
    Status      = status;
    Description = description;
    CreatedBy   = created_by;
    CreatedAt   = created_at;
    ModifiedBy  = modified_by;
    ModifiedAt  = modified_at;
  }
}